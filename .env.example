# Documentation only: no automatic dotenv loading.
OMNI_BACKEND=ssh
OMNI_SSH_HOST=dog4
OMNI_ROBOT_ID=dog4
OMNI_TIMEOUT=12
OMNI_SSH_CONNECT_TIMEOUT=10
OMNI_ALLOW_WRITES=0
OMNI_ALLOWED_ROBOTS=
# For SSH posture, forward, localization and recording, explicitly enable:
# OMNI_ALLOW_WRITES=1
# OMNI_ALLOWED_ROBOTS=dog4
# OMNI_TIMEOUT=30
# Localization/recording may need OMNI_TIMEOUT=60.
# Each operation still needs execute=true / CLI --execute.
# Inspection/navigation/cancellation execution requires the HTTP backend below.
# HTTP backend only:
# OMNI_BASE_URL=https://your-inspection-server.example
# OMNI_TOKEN=replace-with-your-own-token
